{
  "description": "Continue OpenAI runtime sessions when any watched LivingRuntime durable job finishes.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "watch_pi_job$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "livingruntime_remote",
            "tool": "bind_openai_pi_continuation",
            "input": {
              "session_id": "${session_id}",
              "job_id": "${tool_input.job_id}"
            },
            "timeout": 30,
            "statusMessage": "Arming Pi Remote continuation"
          }
        ]
      },
      {
        "matcher": "watch_long_job$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "livingruntime_remote",
            "tool": "bind_openai_job_continuation",
            "input": {
              "session_id": "${session_id}",
              "job_id": "${tool_input.job_id}"
            },
            "timeout": 30,
            "statusMessage": "Arming durable job continuation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "livingruntime_remote",
            "tool": "continue_openai_job",
            "input": {
              "session_id": "${session_id}",
              "timeout_seconds": 25,
              "stop_hook_active": "${stop_hook_active}"
            },
            "timeout": 30,
            "statusMessage": "Checking durable job continuation"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "livingruntime_remote",
            "tool": "continue_openai_job",
            "input": {
              "session_id": "${session_id}",
              "timeout_seconds": 3,
              "interrupted": true
            },
            "timeout": 5,
            "statusMessage": "Cancelling durable job continuation"
          }
        ]
      }
    ]
  }
}

{
  "description": "Recover durable LivingRuntime bindings on session activity and bind watched jobs without holding model turns open.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "livingruntime_remote",
            "tool": "recover_openai_job_continuation",
            "input": {
              "session_id": "${session_id}",
              "hook_event_name": "SessionStart"
            },
            "timeout": 15,
            "statusMessage": "Recovering durable job continuation"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "livingruntime_remote",
            "tool": "recover_openai_job_continuation",
            "input": {
              "session_id": "${session_id}",
              "hook_event_name": "UserPromptSubmit"
            },
            "timeout": 15,
            "statusMessage": "Checking durable job backlog"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "watch_pi_job$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "livingruntime_remote",
            "tool": "bind_openai_pi_continuation",
            "input": {
              "session_id": "${session_id}",
              "job_id": "${tool_input.job_id}"
            },
            "timeout": 30,
            "statusMessage": "Arming Pi Remote continuation"
          }
        ]
      },
      {
        "matcher": "watch_long_job$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "livingruntime_remote",
            "tool": "bind_openai_job_continuation",
            "input": {
              "session_id": "${session_id}",
              "job_id": "${tool_input.job_id}"
            },
            "timeout": 30,
            "statusMessage": "Arming durable job continuation"
          }
        ]
      }
    ]
  }
}
